# Docker Compose 环境变量示例：复制为 .env 后填写，禁止提交 .env
MYSQL_ROOT_PASSWORD=change-me-strong-password
MYSQL_DATABASE=smarten_energy
MYSQL_PORT=3307
BACKEND_PORT=8080
WEB_PORT=8081

# 必须替换为 >= 32 字节随机值，例如：openssl rand -base64 48
SMARTEN_JWT_SECRET=change-me-generate-with-openssl-rand-base64-48

# 允许的前端来源（多个用逗号分隔）
SMARTEN_CORS_ORIGINS=http://localhost:8081
