# Docker Compose 环境变量示例：复制为 .env 后修改
MYSQL_ROOT_PASSWORD=smarten_root_2026
MYSQL_DATABASE=smarten_energy
MYSQL_PORT=3307
BACKEND_PORT=8080
WEB_PORT=8081

# 生产必须替换为 >= 32 字节的随机字符串
SMARTEN_JWT_SECRET=smarten-prod-secret-change-me-0123456789abcdef

# 允许的前端来源（多个用逗号分隔）
SMARTEN_CORS_ORIGINS=http://localhost:8081
