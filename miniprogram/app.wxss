page {
  background-color: #f4f6f9;
  color: #1f2d3d;
  font-size: 28rpx;
  font-family: -apple-system, 'PingFang SC', 'Helvetica Neue', sans-serif;
}

.container {
  padding: 24rpx;
}

.card {
  background: #ffffff;
  border-radius: 16rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(15, 42, 67, 0.06);
}

.card-title {
  font-size: 30rpx;
  font-weight: 600;
  margin-bottom: 20rpx;
}

.row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f0f2f5;
}

.row:last-child {
  border-bottom: none;
}

.row-label {
  color: #909399;
  font-size: 26rpx;
}

.row-value {
  color: #303133;
  font-size: 26rpx;
  word-break: break-all;
  text-align: right;
  max-width: 60%;
}

.btn-primary {
  background: #1f6feb;
  color: #ffffff;
  border-radius: 12rpx;
}

.btn-ghost {
  background: #ffffff;
  color: #1f6feb;
  border: 1rpx solid #1f6feb;
  border-radius: 12rpx;
}

.muted {
  color: #909399;
  font-size: 24rpx;
}

/* ---------- 通用标签与表单 ---------- */
.tag {
  display: inline-block;
  padding: 4rpx 14rpx;
  border-radius: 8rpx;
  font-size: 22rpx;
  background: #eef3fb;
  color: #1f6feb;
}

.tag-warn { background: #fdf6ec; color: #e6a23c; }
.tag-danger { background: #fef0f0; color: #e5484d; }
.tag-success { background: #eefaf2; color: #2f9e44; }

.danger { color: #e5484d; }

.center { text-align: center; }