.top {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 8rpx;
}

.title {
  font-size: 30rpx;
  font-weight: 600;
  flex: 1;
}

.danger { color: #e5484d; }

.text {
  font-size: 26rpx;
  color: #606266;
  line-height: 1.7;
}

.progress {
  margin-top: 16rpx;
  height: 12rpx;
  background: #f0f2f5;
  border-radius: 6rpx;
  overflow: hidden;
}

.progress-bar {
  height: 12rpx;
  background: #1f6feb;
}

.feedback {
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f0f2f5;
}

.feedback:last-child { border-bottom: none; }

.fb-top {
  display: flex;
  justify-content: space-between;
  margin-bottom: 8rpx;
}

.fb-type {
  font-size: 26rpx;
  font-weight: 600;
  color: #1f6feb;
}

.images {
  display: flex;
  gap: 12rpx;
  margin-top: 12rpx;
  flex-wrap: wrap;
}

.images image {
  width: 140rpx;
  height: 140rpx;
  border-radius: 10rpx;
}

.actions {
  display: flex;
  gap: 20rpx;
  margin-top: 10rpx;
}

.actions button {
  flex: 1;
  height: 88rpx;
  line-height: 88rpx;
  font-size: 28rpx;
}
