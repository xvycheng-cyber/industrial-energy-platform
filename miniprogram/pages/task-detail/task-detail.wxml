<view class="container" wx:if="{{task}}">
  <view class="card">
    <view class="top">
      <text class="title">{{task.title}}</text>
      <text class="tag {{task.status === 5 ? 'tag-danger' : task.status === 4 ? 'tag-success' : 'tag-warn'}}">{{task.statusLabel}}</text>
    </view>
    <view class="muted">{{task.taskNo}}</view>
    <view class="row"><text class="row-label">设备</text><text class="row-value">{{task.deviceName || '—'}}</text></view>
    <view class="row"><text class="row-label">产线</text><text class="row-value">{{task.lineName || '—'}}</text></view>
    <view class="row"><text class="row-label">截止时间</text><text class="row-value {{task.overdue ? 'danger' : ''}}">{{task.deadline || '未设置'}}</text></view>
    <view class="row"><text class="row-label">预期节能量</text><text class="row-value">{{task.expectedSaving || 0}} kWh</text></view>
    <view class="row"><text class="row-label">整改进度</text><text class="row-value">{{task.progress || 0}}%</text></view>
    <view class="progress"><view class="progress-bar" style="width:{{task.progress || 0}}%"></view></view>
  </view>

  <view class="card" wx:if="{{task.measure}}">
    <view class="card-title">整改措施</view>
    <text class="text">{{task.measure}}</text>
  </view>

  <view class="card" wx:if="{{task.reportConclusion}}">
    <view class="card-title">诊断结论</view>
    <text class="text">{{task.reportConclusion}}</text>
  </view>

  <view class="card" wx:if="{{task.rejectReason}}">
    <view class="card-title danger">驳回原因</view>
    <text class="text danger">{{task.rejectReason}}</text>
  </view>

  <view class="card">
    <view class="card-title">整改反馈</view>
    <view wx:if="{{task.feedbacks.length === 0}}" class="muted">暂无反馈</view>
    <view wx:for="{{task.feedbacks}}" wx:key="id" class="feedback">
      <view class="fb-top">
        <text class="fb-type">{{item.feedbackTypeLabel}}</text>
        <text class="muted">{{item.submitTime}}</text>
      </view>
      <text class="text">{{item.content}}</text>
      <view wx:if="{{item.beforeDesc}}" class="muted">整改前：{{item.beforeDesc}}</view>
      <view wx:if="{{item.afterDesc}}" class="muted">整改后：{{item.afterDesc}}</view>
      <view wx:if="{{item.images.length}}" class="images">
        <image
          wx:for="{{item.images}}"
          wx:for-item="img"
          wx:key="*this"
          src="{{img}}"
          mode="aspectFill"
          data-src="{{img}}"
          data-urls="{{item.images}}"
          bindtap="preview"
        />
      </view>
    </view>
  </view>

  <view class="actions" wx:if="{{task.status === 1 || task.status === 2}}">
    <button wx:if="{{task.status === 1}}" class="btn-primary" loading="{{starting}}" bindtap="start">开始整改</button>
    <button class="btn-ghost" bindtap="goFeedback">提交整改反馈</button>
  </view>
</view>
<view wx:else class="container muted">加载中…</view>
