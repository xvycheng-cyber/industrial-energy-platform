.hero {
  background: linear-gradient(135deg, #0f2a43 0%, #1a4a75 100%);
  border-radius: 20rpx;
  padding: 36rpx 32rpx;
  color: #ffffff;
  margin-bottom: 24rpx;
}

.hello {
  font-size: 38rpx;
  font-weight: 700;
}

.role {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.7);
}

.stats {
  display: flex;
  margin-top: 28rpx;
}

.stat {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.num {
  font-size: 40rpx;
  font-weight: 700;
}

.stat .label {
  margin-top: 4rpx;
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.7);
}

.quick {
  display: flex;
  justify-content: space-around;
}

.quick-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
  font-size: 24rpx;
  color: #606266;
}

.quick-icon {
  width: 84rpx;
  height: 84rpx;
  line-height: 84rpx;
  text-align: center;
  border-radius: 22rpx;
  color: #ffffff;
  font-size: 32rpx;
  font-weight: 600;
}

.quick-icon.blue { background: #1f6feb; }
.quick-icon.orange { background: #e6a23c; }
.quick-icon.green { background: #2f9e44; }

.task-item {
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f0f2f5;
}

.task-item:last-child { border-bottom: none; }

.task-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 8rpx;
}

.task-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #1f2d3d;
}

.progress {
  margin-top: 14rpx;
  height: 10rpx;
  background: #f0f2f5;
  border-radius: 6rpx;
  overflow: hidden;
}

.progress-bar {
  height: 10rpx;
  background: #1f6feb;
}
