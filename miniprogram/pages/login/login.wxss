.login {
  min-height: 100vh;
  padding: 120rpx 48rpx 60rpx;
  box-sizing: border-box;
  background: linear-gradient(180deg, #0f2a43 0%, #123a5c 38%, #f4f6f9 38%);
}

.brand {
  text-align: center;
  color: #ffffff;
  margin-bottom: 60rpx;
}

.logo {
  width: 108rpx;
  height: 108rpx;
  line-height: 108rpx;
  margin: 0 auto 20rpx;
  border-radius: 24rpx;
  background: #1f6feb;
  font-size: 54rpx;
  font-weight: 700;
  text-align: center;
}

.title {
  font-size: 44rpx;
  font-weight: 700;
  letter-spacing: 4rpx;
}

.subtitle {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.72);
}

.form {
  padding: 40rpx 32rpx;
}

.form-item {
  margin-bottom: 32rpx;
}

.label {
  display: block;
  font-size: 26rpx;
  color: #606266;
  margin-bottom: 14rpx;
}

.input {
  height: 88rpx;
  padding: 0 24rpx;
  background: #f7f9fc;
  border-radius: 12rpx;
  font-size: 28rpx;
}

.login-btn {
  margin-top: 16rpx;
  height: 88rpx;
  line-height: 88rpx;
  font-size: 30rpx;
}

.diagnose {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 16rpx;
  margin-top: 22rpx;
  padding: 12rpx 4rpx;
}

.diagnose-link {
  flex: none;
  font-size: 24rpx;
  color: #1f6feb;
}

.diagnose-base {
  flex: 1;
  text-align: right;
  font-size: 20rpx;
  color: #909399;
  word-break: break-all;
}

.tip {
  margin-top: 24rpx;
  text-align: center;
}
